CREATE CONSTRAINT documento_id IF NOT EXISTS FOR (n:Documento) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT secao_id IF NOT EXISTS FOR (n:Secao) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT trecho_id IF NOT EXISTS FOR (n:Trecho) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT regra_id IF NOT EXISTS FOR (n:Regra) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT situacao_id IF NOT EXISTS FOR (n:Situacao) REQUIRE n.id IS UNIQUE;
CREATE INDEX trecho_artigo IF NOT EXISTS FOR (n:Trecho) ON (n.article);
CREATE FULLTEXT INDEX trecho_texto IF NOT EXISTS FOR (n:Trecho) ON EACH [n.text];

UNWIND [{id: "portaria-11685-2026/iv-b/art-36/caput", article_id: "portaria-11685-2026/iv-b/art-36", section: "IV-B", article: 36, paragraph: null, pages: [7], text: "Art. 36. Na triagem clínica, o profissional de saúde de nível superior, qualificado e capacitado, atuando sob supervisão médica, avaliará os antecedentes e o estado clínico atual do candidato, observadas as disposições deste Anexo, visando à proteção da saúde do doador e à segurança dos hemocomponentes destinados aos receptores."},
{id: "portaria-11685-2026/iv-b/art-36/par-1", article_id: "portaria-11685-2026/iv-b/art-36", section: "IV-B", article: 36, paragraph: 1, pages: [8], text: "§ 1º A avaliação de que trata o caput será realizada mediante entrevista individual, em ambiente que assegure a privacidade e o sigilo das informações prestadas, sendo obrigatória a manutenção e rastreabilidade do respectivo registro."},
{id: "portaria-11685-2026/iv-b/art-36/par-2", article_id: "portaria-11685-2026/iv-b/art-36", section: "IV-B", article: 36, paragraph: 2, pages: [8], text: "§ 2º O serviço de hemoterapia poderá disponibilizar ao candidato questionário estruturado prévio à entrevista individual, inclusive por meio digital, cujo preenchimento não dispensa a avaliação presencial por profissional de saúde para o esclarecimento de dúvidas, fornecimento de orientações e conclusão da triagem clínica."},
{id: "portaria-11685-2026/iv-b/art-38/caput", article_id: "portaria-11685-2026/iv-b/art-38", section: "IV-B", article: 38, paragraph: null, pages: [8], text: "Art. 38. A frequência máxima admitida, no intervalo de doze meses, é de quatro doações de sangue total para o homem e de três doações para a mulher, exceto em circunstâncias especiais, que devem ser avaliadas e aprovadas pelo responsável técnico do serviço de hemoterapia."},
{id: "portaria-11685-2026/iv-b/art-38/par-1", article_id: "portaria-11685-2026/iv-b/art-38", section: "IV-B", article: 38, paragraph: 1, pages: [8], text: "§ 1º O intervalo mínimo entre doações de sangue total deve ser de dois meses para os homens e de três meses para as mulheres."},
{id: "portaria-11685-2026/iv-b/art-38/par-2", article_id: "portaria-11685-2026/iv-b/art-38", section: "IV-B", article: 38, paragraph: 2, pages: [8], text: "§ 2º Em caso de doador autólogo, a frequência e o intervalo entre as doações devem ser programados de acordo com o protocolo aprovado pelo responsável técnico do serviço de hemoterapia."},
{id: "portaria-11685-2026/iv-b/art-39/caput", article_id: "portaria-11685-2026/iv-b/art-39", section: "IV-B", article: 39, paragraph: null, pages: [8], text: "Art. 39. O doador de sangue ou componentes deverá ter idade entre dezesseis anos completos e sessenta e nove anos, onze meses e vinte e nove dias."},
{id: "portaria-11685-2026/iv-b/art-39/par-1", article_id: "portaria-11685-2026/iv-b/art-39", section: "IV-B", article: 39, paragraph: 1, pages: [8], text: "§ 1º Os candidatos à doação de sangue com idade entre dezesseis e dezoito anos incompletos anos devem trazer consentimento formal, por escrito, do seu responsável legal para cada doação que realizar, juntamente com a cópia da identidade da pessoa que assina o documento (a cópia não precisa ser autenticada)."},
{id: "portaria-11685-2026/iv-b/art-39/par-2", article_id: "portaria-11685-2026/iv-b/art-39", section: "IV-B", article: 39, paragraph: 2, pages: [8], text: "§ 2º O consentimento do responsável legal de que trata o § 1º deve incluir a autorização para o cumprimento das exigências e responsabilidades estabelecidas aos demais doadores, bem como para submeter-se à triagem clínica e realizar e receber os resultados da triagem laboratorial, na forma prevista no art. 33."},
{id: "portaria-11685-2026/iv-b/art-39/par-3", article_id: "portaria-11685-2026/iv-b/art-39", section: "IV-B", article: 39, paragraph: 3, pages: [8], text: "§ 3º O limite para a primeira doação será de sessenta anos, onze meses e vinte e nove dias."},
{id: "portaria-11685-2026/iv-b/art-39/par-4", article_id: "portaria-11685-2026/iv-b/art-39", section: "IV-B", article: 39, paragraph: 4, pages: [8], text: "§ 4º Em casos de necessidades tecnicamente justificáveis, o candidato à doação de sangue cuja idade seja inferior a dezesseis anos ou superior a sessenta anos, onze meses e vinte e nove dias na primeira doação, será aceito como doador após avaliação pelo médico do serviço de hemoterapia, com avaliação dos riscos, benefícios e apresentação de relatório que justifique a necessidade da doação, registrando-a na ficha do doador."},
{id: "portaria-11685-2026/iv-b/art-39/par-5", article_id: "portaria-11685-2026/iv-b/art-39", section: "IV-B", article: 39, paragraph: 5, pages: [8], text: "§ 5º Será permitido aos doadores de repetição com idade superior a setenta anos, a continuidade da doação, após avaliação médica pelo serviço de hemoterapia,"},
{id: "portaria-11685-2026/iv-b/art-40/caput", article_id: "portaria-11685-2026/iv-b/art-40", section: "IV-B", article: 40, paragraph: null, pages: [8], text: "Art. 40. Para ser selecionado para doação, o candidato deve ter, no mínimo, peso de 50 kg (cinquenta quilogramas)."},
{id: "portaria-11685-2026/iv-b/art-40/par-1", article_id: "portaria-11685-2026/iv-b/art-40", section: "IV-B", article: 40, paragraph: 1, pages: [8], text: "§ 1º Candidatos com peso abaixo de 50 kg (cinquenta quilogramas) poderão ser aceitos para fins de doação após avaliação médica, desde que o volume coletado seja ajustado ao máximo de 8mL/kg para mulheres e 9 mL/kg para homens e o volume do anticoagulante na bolsa de coleta seja proporcional ao volume a ser coletado, respeitadas as demais determinações deste Anexo."},
{id: "portaria-11685-2026/iv-b/art-40/par-2", article_id: "portaria-11685-2026/iv-b/art-40", section: "IV-B", article: 40, paragraph: 2, pages: [8], text: "§ 2º Não serão selecionados os candidatos à doação que apresentarem perda de peso inexplicável superior a 10% (dez por cento) da massa corporal nos três meses que antecederem à doação."}] AS row
MERGE (d:Documento {id: "portaria-11685-2026"})
SET d += {id: "portaria-11685-2026", filename: "Minist�rio da Sa�de.pdf", source_url: "https://bvsms.saude.gov.br/bvs/saudelegis/gm/2026/prt11685_03_07_2026.html", sha256: "c95cce275d3f119595c74989151f57baf339c61d89a3930b7fcc3571857a1fa1", page_count: 71}
MERGE (s:Secao {id: d.id + '/' + row.section})
SET s.nome = row.section
MERGE (d)-[:CONTEM]->(s)
MERGE (t:Trecho {id: row.id})
SET t += row
MERGE (s)-[:CONTEM]->(t);

UNWIND [{id: "portaria-11685-2026/iv-b/art-38/caput/regra-69606898851fa992", chunk_id: "portaria-11685-2026/iv-b/art-38/caput", situation_id: "frequencia-de-doacoes", situation: "Frequencia de doacoes", condition: "Consultar as condicoes do art. 38.", effect: "Art. 38. A frequência máxima admitida, no intervalo de doze meses, é de quatro doações de sangue total para o homem e de três doações para a mulher, exceto em circunstâncias especiais, que devem ser avaliadas e aprovadas pelo responsável técnico do serviço de hemoterapia.", evidence: "Art. 38. A frequência máxima admitida, no intervalo de doze meses, é de quatro doações de sangue total para o homem e de três doações para a mulher, exceto em circunstâncias especiais, que devem ser avaliadas e aprovadas pelo responsável técnico do serviço de hemoterapia.", status: "referencia_documental"},
